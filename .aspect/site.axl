load(".aspect/helpers.axl", "run_aspect")

def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    mode = ctx.args.mode[0]
    targets = {
        "dev": "//docs/site:astro_dev",
        "preview": "//docs/tools/docs:preview_site",
        "tidewave": "//docs/site:astro_dev_tidewave",
    }
    if mode not in targets:
        print("unknown site mode: " + mode)
        return 2
    if mode == "preview":
        build = run_aspect(ctx, ["run", "//docs/tools/docs:stage_site"], root)
        if build != 0:
            return build
    if mode in ["dev", "tidewave"]:
        return run_aspect(ctx, [
            "run",
            targets[mode],
            "--",
            "--root",
            root + "/docs/site",
            "dev",
            "--host=0.0.0.0",
            "--port=4321",
        ], root)
    return run_aspect(ctx, ["run", targets[mode]], root)

hovel_site = task(
    args = {
        "mode": args.positional(default = ["dev"], minimum = 0, maximum = 1, description = "Mode: dev (Astro HMR), tidewave (HMR plus localhost MCP), or preview (assembled Pages site)."),
    },
    summary = "Serve the Hovel site with live refresh through Bazel-managed tools.",
    implementation = _impl,
)
