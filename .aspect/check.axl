load(".aspect/helpers.axl", "run_steps")

def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    scopes = {
        "repo": [
            (["run", "//tools/bazel/buildifier:buildifier", "--", "--mode=check"], root),
            (["run", "//tools/bazel/policy:repo_policy"], root),
            (["test", "//:repo_quality_test"], root),
        ],
        "core": [
            (["run", "//tools/lint:gofmt_workspace", "--", "--mode=check"], root + "/core"),
            (["run", "//tools/lint:golangci_lint_workspace"], root + "/core"),
            (["run", "//:gazelle", "--", "-mode=diff"], root + "/core"),
            (["build", "//:build"], root + "/core"),
            (["test", "//:ci_test", "//:race_test", "//:fuzz_smoke_test"], root + "/core"),
            (["test", "--bazel-flag=--collect_code_coverage", "--bazel-flag=--combined_report=lcov", "//internal/domain/...", "//internal/app/..."], root + "/core"),
            (["run", "//tools/tests:check_coverage", "--", "--analyze-go-report"], root + "/core"),
        ],
        "sdk": [
            (["run", "//tools/lint:python_check"], root + "/core"),
            (["run", "//tools/lint:format_rust_workspace", "--", "--mode=check"], root + "/core"),
            (["build", "//:sdk_build"], root),
            (["test", "//:sdk_test"], root),
        ],
        "module-examples": [
            (["build", "//:module_examples_build"], root),
            (["test", "//:module_examples_test"], root),
        ],
        "modules": [
            (["run", "//tools/lint:gofmt_workspace", "--", "--mode=check", "--path", "../modules/squatter"], root + "/core"),
            (["build", "//:modules_build"], root),
            (["test", "//:modules_test"], root),
            (["test", "--bazel-flag=--config=picblobs_ci", "//modules/picblobs:bazel_test_suite"], root),
        ],
        "docs": [
            (["test", "//:docs_test"], root),
            (["build", "//docs/tools/docs:site"], root),
        ],
    }
    selected = ctx.args.scope[0]
    if selected == "all":
        steps = []
        for name in ["repo", "core", "sdk", "module-examples", "modules", "docs"]:
            steps.extend(scopes[name])
        return run_steps(ctx, steps)
    if selected not in scopes:
        print("unknown check scope: " + selected)
        return 2
    return run_steps(ctx, scopes[selected])

hovel_check = task(
    args = {"scope": args.positional(default = ["all"], minimum = 0, maximum = 1, description = "Scope: all, repo, core, sdk, module-examples, modules, or docs.")},
    summary = "Run the complete non-publishing Hovel verification gate.",
    implementation = _impl,
)
