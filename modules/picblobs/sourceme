#!/usr/bin/env bash
# Source this file to run the Aspect-backed setup path:
#   source sourceme
#
# Aspect/Bazel owns the repository tools and generated-file check.

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "error: this script must be sourced, not executed" >&2
  echo "  source sourceme" >&2
  exit 1
fi

_picblobs_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v aspect >/dev/null 2>&1; then
  echo "error: 'aspect' not found. Install it: https://aspect.build/docs/cli/installation" >&2
  return 1
fi

( cd "${_picblobs_root}/../.." && aspect run //modules/picblobs/tools:generate_check ) || return 1

echo "==> Ready. Tools are provided by Aspect/Bazel targets. Try: aspect help"

unset _picblobs_root
